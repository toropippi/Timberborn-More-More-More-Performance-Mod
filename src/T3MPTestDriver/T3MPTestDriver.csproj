      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(TimberbornManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Publicize Include="Timberborn.SingletonSystem" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="Timberborn.TickSystem" IncludeCompilerGeneratedMembers="false" />
