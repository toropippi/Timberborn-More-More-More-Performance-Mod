<Project Sdk="Microsoft.NET.Sdk">
  <!-- Prints LoadBodies fingerprints of game installs with the product's own code; usage in Program.cs. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Shared/MethodFingerprint.cs" Link="MethodFingerprint.cs" />
    <Compile Include="../../src/Shared/LoadBodies.cs" Link="LoadBodies.cs" />
  </ItemGroup>
</Project>
